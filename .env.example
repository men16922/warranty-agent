# warranty — 환경 설정 견본
#
# 실제 값은 `.env`에 두고 **커밋하지 않는다**(.gitignore).
# 변수 목록의 권위는 specs/warranty/design/06-interfaces.md §6이다.
#
# ⚠️ 이 파일에 비밀값을 적지 않는다. 여기 있는 것은 전부 비밀이 아닌 식별자다.
# ⚠️ 다른 프로젝트의 자격증명(AWS 키·Slack·GitHub 시크릿)을 여기로 옮기지 않는다 —
#    warranty는 그것들을 쓰지 않고, 옮기면 노출 면만 넓어진다.

# ── 필수 ────────────────────────────────────────────────────────────────
# 배포·과금이 일어나는 프로젝트. D9에 따라 **전용 프로젝트**여야 한다
# (청구 귀속이 깨끗해지고 teardown이 프로젝트 삭제 하나로 끝난다).
WR_PROJECT_ID=

# Cloud Run·Vertex 리전. spec 기본값은 us-central1 (design/08-deployment.md §1).
WR_REGION=us-central1

# ── 모델 (REQ-501) ──────────────────────────────────────────────────────
WR_MODEL=gemini-3.7-flash

# ADK/GenAI SDK가 직접 읽는 변수들. 위 WR_* 값과 어긋나면 config가 거부한다.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# ── 화해 (REQ-401, REQ-404) ─────────────────────────────────────────────
# BigQuery 결제 내보내기 테이블. 콘솔에서 내보내기를 켠 뒤에야 존재한다(T0-3).
# 형식: <project>.<dataset>.gcp_billing_export_v1_<BILLING_ACCOUNT_ID>
WR_BILLING_TABLE=

# 이 일수 안에 청구 행이 안 오면 unreconciled로 표시한다.
# ⚠️ 관측에서 온 가정이지 보증이 아니다 (DECISIONS OD-2).
WR_RECONCILE_DEADLINE_DAYS=3

# ── 어댑터 (REQ-701) ────────────────────────────────────────────────────
# live | fake. ⚠️ 기본을 fake로 두지 않는다 — 배포가 조용히 가짜로 돌 수 있다.
# 테스트는 명시적으로 fake를 주입하고, 게이트는 라이브 어댑터를 만들지 않는다.
WR_ADAPTERS=live
