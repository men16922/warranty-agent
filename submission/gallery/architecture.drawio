        <mxCell id="page" value="&lt;b&gt;GET /&lt;/b&gt;&amp;nbsp; read-only ledger page&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5F6368&quot;&gt;no buttons · nothing to install&lt;/font&gt;"
          style="rounded=1;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontSize=13;arcSize=8;"
