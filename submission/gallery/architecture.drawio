<mxfile host="app.diagrams.net" agent="warranty" version="24.0.0">
  <diagram name="warranty — architecture" id="warranty-arch">
    <mxGraphModel dx="1800" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1"
                  arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="760"
                  math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="ttl" value="&lt;b&gt;The agent that &lt;font color=&quot;#E8710A&quot;&gt;provisions&lt;/font&gt; a resource also writes down how to &lt;font color=&quot;#E8710A&quot;&gt;verify&lt;/font&gt; and &lt;font color=&quot;#E8710A&quot;&gt;undo&lt;/font&gt; it.&lt;/b&gt;"
          style="text;html=1;fontSize=26;fontColor=#202124;verticalAlign=middle;align=left;"
          vertex="1" parent="1"><mxGeometry x="48" y="26" width="1500" height="36" as="geometry"/></mxCell>
        <mxCell id="sub" value="The gate is deterministic code. The model picks the tool and judges only the ambiguous verdicts — and its rationale is recorded in the ledger row."
          style="text;html=1;fontSize=14;fontColor=#5F6368;verticalAlign=middle;align=left;"
          vertex="1" parent="1"><mxGeometry x="48" y="64" width="1500" height="22" as="geometry"/></mxCell>

        <mxCell id="run" value="Cloud Run · warranty-api   (scale-to-zero, min-instances=0)"
          style="rounded=1;html=1;fillColor=#F8F9FA;strokeColor=#4285F4;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontColor=#4285F4;fontStyle=1;arcSize=4;"
          vertex="1" parent="1"><mxGeometry x="48" y="108" width="1160" height="512" as="geometry"/></mxCell>

        <mxCell id="agent" value="&lt;b&gt;ADK Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5F6368&quot;&gt;Gemini 3.7 Flash · Vertex AI&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5F6368&quot;&gt;tools: provision · inspect · remediate · report&lt;/font&gt;"
          style="rounded=1;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=14;arcSize=8;"
          vertex="1" parent="1"><mxGeometry x="80" y="152" width="250" height="86" as="geometry"/></mxCell>

        <mxCell id="d1lbl" value="DAY 1" style="text;html=1;fontSize=11;fontColor=#80868B;fontStyle=1;align=left;"
          vertex="1" parent="1"><mxGeometry x="80" y="262" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="prov" value="&lt;b&gt;provision&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5F6368&quot;&gt;creates the resource&lt;/font&gt;"
          style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;fontSize=13;arcSize=8;"
          vertex="1" parent="1"><mxGeometry x="80" y="284" width="160" height="62" as="geometry"/></mxCell>
        <mxCell id="ctr" value="&lt;b&gt;★ Operational Contract&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5F6368&quot;&gt;health signal · recovery criterion&lt;br&gt;rollback plan · reversibility&lt;/font&gt;"
          style="rounded=1;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontSize=13;arcSize=8;strokeWidth=2;"
          vertex="1" parent="1"><mxGeometry x="292" y="276" width="230" height="78" as="geometry"/></mxCell>
        <mxCell id="later" value="&lt;font style=&quot;font-size:12px;color:#5F6368&quot;&gt;… months later: the author is gone,&lt;br&gt;the doc rotted. &lt;b style=&quot;color:#202124&quot;&gt;The contract did not.&lt;/b&gt;&lt;/font&gt;"
          style="rounded=1;html=1;fillColor=none;strokeColor=#DADCE0;dashed=1;fontSize=12;arcSize=8;align=left;spacingLeft=12;"
          vertex="1" parent="1"><mxGeometry x="574" y="284" width="280" height="62" as="geometry"/></mxCell>

        <mxCell id="d2lbl" value="DAY 2" style="text;html=1;fontSize=11;fontColor=#80868B;fontStyle=1;align=left;"
          vertex="1" parent="1"><mxGeometry x="80" y="404" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="gate" value="&lt;b&gt;Decision Gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5F6368&quot;&gt;reversible × &lt;b&gt;verifiable&lt;/b&gt; × budget&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#B06000&quot;&gt;deterministic — not the model&lt;/font&gt;"
          style="rounded=1;html=1;fillColor=#FEF7E0;strokeColor=#E8710A;fontSize=13;arcSize=8;strokeWidth=2;"
          vertex="1" parent="1"><mxGeometry x="80" y="426" width="216" height="76" as="geometry"/></mxCell>
        <mxCell id="exec" value="&lt;b&gt;execute&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5F6368&quot;&gt;traffic split · concurrency&lt;/font&gt;"
          style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;fontSize=13;arcSize=8;"
          vertex="1" parent="1"><mxGeometry x="340" y="434" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="ver" value="&lt;b&gt;★ verify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5F6368&quot;&gt;wait &lt;b&gt;longer than the window&lt;/b&gt;,&lt;br&gt;then re-measure the &lt;b&gt;same&lt;/b&gt; signal&lt;/font&gt;"
          style="rounded=1;html=1;fillColor=#E6F4EA;strokeColor=#34A853;fontSize=13;arcSize=8;strokeWidth=2;"
          vertex="1" parent="1"><mxGeometry x="554" y="426" width="236" height="76" as="geometry"/></mxCell>
        <mxCell id="rb" value="&lt;b&gt;★ rollback&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5F6368&quot;&gt;traffic → previous revision,&lt;br&gt;then &lt;b&gt;read the split back&lt;/b&gt;&lt;/font&gt;"
          style="rounded=1;html=1;fillColor=#FCE8E6;strokeColor=#EA4335;fontSize=13;arcSize=8;strokeWidth=2;"
          vertex="1" parent="1"><mxGeometry x="844" y="426" width="226" height="76" as="geometry"/></mxCell>

        <mxCell id="vok" value="recovered — keep it, and say so"
