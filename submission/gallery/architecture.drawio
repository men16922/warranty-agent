        <mxCell id="fs" value="&lt;b&gt;Firestore&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5F6368&quot;&gt;contracts + ledger&lt;br&gt;create() — one action, one row&lt;/font&gt;"
          style="rounded=1;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontSize=13;arcSize=8;"
