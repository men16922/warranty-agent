          vertex="1" parent="1"><mxGeometry x="1276" y="150" width="244" height="68" as="geometry"/></mxCell>
        <mxCell id="cra" value="&lt;b&gt;Cloud Run Admin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5F6368&quot;&gt;traffic split — one call,&lt;br&gt;atomic, and readable back&lt;/font&gt;"
          style="rounded=1;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=13;arcSize=8;"
