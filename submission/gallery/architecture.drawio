        <mxCell id="cm" value="&lt;b&gt;Cloud Monitoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5F6368&quot;&gt;p95 request_latencies&lt;br&gt;same filter · same aligner&lt;/font&gt;"
